<Project>

  <PropertyGroup>
    <InteropSearchApiAssemblyPath>$(MSBuildThisFileDirectory)winsdk/interop.searchapi.dll</InteropSearchApiAssemblyPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.PowerShell.5.1.ReferenceAssemblies" Version="1.0.0" />
    <PackageVersion Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageVersion Include="platyPS" Version="0.14.2" />
    <PackageVersion Include="PowerShellStandard.Library" Version="5.1.1" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.CodeCoverage" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.6.9" />
    <PackageVersion Include="System.Management.Automation" Version="7.6.9" />
  </ItemGroup>

</Project>
