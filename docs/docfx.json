{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "*.csproj"
          ],
          "src": "../src/Mawosoft.PowerShell.WindowsSearchManager"
        }
      ],
      "dest": "../artifacts/obj/docs/site/api",
      "filter": "filter.yml",
      "noRestore": true,
      "properties": {
        "NoMamlHelp": "true"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": "**/*.*",
        "exclude": "api/toc.yml",
        "src": "../artifacts/obj/docs/site"
      }
    ],
    "dest": "../artifacts/bin/docs/site",
    "globalMetadata": {
      "_appTitle": "Windows Search Manager",
      "_appFooter": "Copyright &copy; 2023-2026 Matthias Wolf, Mawosoft",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableBreadcrumb": true,
      "_disableContribution": true
    },
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "templates/custom"
    ],
    "xref": [
      "xrefmap-SearchAPI.yml",
      "xrefmap-PowerShell.yml"
    ],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": true,
    "disableGitFeatures": false
  }
}
